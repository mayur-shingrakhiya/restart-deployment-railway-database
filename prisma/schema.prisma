  tradingexp                     String?               @db.VarChar(254)
  type_proof                     String?               @db.VarChar(20)
  group_plan                     String?               @db.VarChar(30)
  assign_status                  Int?
  broker_code                    String?               @db.VarChar(20)
  asset_value                    String?               @db.VarChar(15)
  source_funds                   String?               @db.VarChar(15)
  share_exp                      String?               @db.VarChar(3)
  risk_market                    String?               @db.VarChar(3)
  trading_style                  String?               @db.VarChar(100)
