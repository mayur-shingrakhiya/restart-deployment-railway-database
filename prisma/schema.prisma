  countrycode                    String?               @db.VarChar(11)
  chaavi                         String?               @db.VarChar(255)
  nationality                    String?               @db.VarChar(255)
  other_account                  Int?
  subject_tax                    Int?
  pep_person                     Int?
  product_traded                 String?               @db.LongText
  account_type                   ib_users_account_type @default(DEMO)
