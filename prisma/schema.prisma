model payment_gateway {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  deposit_gateway    String   @db.VarChar(255)
  withdrawal_gateway String   @db.VarChar(255)
  created_at         DateTime @default(now()) @db.Timestamp(0)
  updated_at         DateTime @default(now()) @db.Timestamp(0)
  users              users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payment_gateway_ibfk_1")

  @@index([user_id], map: "user_id")
}

model users {
  id              Int               @id @default(autoincrement())
  firstName       String            @db.VarChar(255)
  lastName        String            @db.VarChar(255)
  email           String            @unique(map: "email") @db.VarChar(255)
  password        String            @db.VarChar(255)
  pin             String?           @db.VarChar(255)
  countryCode     String            @db.VarChar(10)
  phoneNumber     String            @db.VarChar(20)
  country         String            @db.VarChar(100)
  state           String            @db.VarChar(100)
  city            String            @db.VarChar(100)
  pincode         String            @db.VarChar(20)
  kyc_verify      Boolean?          @default(false)
  status          users_status?     @default(active)
  created_at      DateTime          @default(now()) @db.Timestamp(0)
  updated_at      DateTime          @default(now()) @db.Timestamp(0)
  accounts        accounts[]
  deposits        deposits[]
  payment_gateway payment_gateway[]
  wallets         wallets[]
}

model wallets {
  id            Int             @id @default(autoincrement())
  user_id       Int
  wallet_number String          @unique(map: "wallet_number") @db.VarChar(255)
  balance       Decimal?        @default(0.00) @db.Decimal(10, 2)
  status        wallets_status? @default(active)
  created_at    DateTime        @default(now()) @db.Timestamp(0)
  updated_at    DateTime        @default(now()) @db.Timestamp(0)
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "wallets_ibfk_1")

  @@index([user_id], map: "user_id")
}

enum ib_users_ib_prefix {
  IB
  MIB
}

enum accounts_account_type {
  mt4
  mt5
}

enum deposits_account_type {
  mt4
  mt5
  wallet
}

enum wallets_status {
  active
  inactive
}

enum accounts_status {
  active
  inactive
}

enum deposits_status {
  pending
  success
  failed
  cancelled
}

enum users_status {
  active
  inactive
}

enum ib_users_status {
  active
  inactive
}

enum ib_users_fundtransfer {
  active
  inactive
}

enum ib_users_account_type {
  LIVE
  DEMO
}
