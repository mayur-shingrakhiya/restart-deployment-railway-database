model mt4_users {
  LOGIN              BigInt   @id
  GROUP              String   @db.Char(16)
  ENABLE             Int
  ENABLE_CHANGE_PASS Int
  ENABLE_READONLY    Int
  ENABLE_OTP         Int      @default(0)
  PASSWORD_PHONE     String   @db.Char(32)
  NAME               String   @db.Char(128)
  COUNTRY            String   @db.Char(32)
  CITY               String   @db.Char(32)
  STATE              String   @db.Char(32)
  ZIPCODE            String   @db.Char(16)
  ADDRESS            String   @db.Char(128)
  LEAD_SOURCE        String   @default("") @db.Char(32)
  PHONE              String   @db.Char(32)
  EMAIL              String   @db.Char(48)
  COMMENT            String   @db.Char(64)
  ID                 String   @db.Char(32)
  STATUS             String   @db.Char(16)
  REGDATE            DateTime @db.DateTime(0)
  LASTDATE           DateTime @db.DateTime(0)
  LEVERAGE           Int
  AGENT_ACCOUNT      Int
  TIMESTAMP          Int
  BALANCE            Float
  PREVMONTHBALANCE   Float
  PREVBALANCE        Float
  CREDIT             Float
  INTERESTRATE       Float
  TAXES              Float
  SEND_REPORTS       Int
  MQID               Int      @default(0) @db.UnsignedInt
  USER_COLOR         Int
  EQUITY             Float    @default(0)
  MARGIN             Float    @default(0)
  MARGIN_LEVEL       Float    @default(0)
  MARGIN_FREE        Float    @default(0)
  CURRENCY           String   @default("") @db.Char(16)
  API_DATA           Bytes?   @db.Blob
  MODIFY_TIME        DateTime @db.DateTime(0)

  @@index([TIMESTAMP], map: "INDEX_STAMP")
}

model mt5_deals {
  Deal             BigInt   @id @default(0) @db.UnsignedBigInt
  Timestamp        BigInt   @default(0)
  ExternalID       String   @default("") @db.VarChar(32)
  Login            BigInt   @default(0) @db.UnsignedBigInt
  Dealer           BigInt   @default(0) @db.UnsignedBigInt
  Order            BigInt   @default(0) @db.UnsignedBigInt
  Action           Int      @default(0) @db.UnsignedInt
  Entry            Int      @default(0) @db.UnsignedInt
  Reason           Int      @default(0) @db.UnsignedInt
  Digits           Int      @default(0) @db.UnsignedInt
  DigitsCurrency   Int      @default(0) @db.UnsignedInt
  ContractSize     Float    @default(0)
  Time             DateTime @default(dbgenerated("('0000-00-00 00:00:00')")) @db.DateTime(0)
  TimeMsc          DateTime @default(dbgenerated("('0000-00-00 00:00:00.000000')")) @db.DateTime(6)
  Symbol           String   @default("") @db.VarChar(32)
  Price            Float    @default(0)
  VolumeExt        BigInt   @default(0) @db.UnsignedBigInt
  Profit           Float    @default(0)
  Storage          Float    @default(0)
  Commission       Float    @default(0)
  Fee              Float    @default(0)
  RateProfit       Float    @default(0)
  RateMargin       Float    @default(0)
  ExpertID         BigInt   @default(0) @db.UnsignedBigInt
  PositionID       BigInt   @default(0) @db.UnsignedBigInt
  PartyID          BigInt   @default(0) @db.UnsignedBigInt
  Comment          String   @default("") @db.VarChar(32)
  ProfitRaw        Float    @default(0)
  PricePosition    Float    @default(0)
  PriceSL          Float    @default(0)
  PriceTP          Float    @default(0)
  VolumeClosedExt  BigInt   @default(0) @db.UnsignedBigInt
  TickValue        Float    @default(0)
  TickSize         Float    @default(0)
  Flags            Int      @default(0) @db.UnsignedInt
  Value            Float    @default(0)
  Gateway          String   @default("") @db.VarChar(16)
  PriceGateway     Float    @default(0)
  VolumeGatewayExt BigInt   @default(0) @db.UnsignedBigInt
  ActionGateway    Int      @default(0) @db.UnsignedInt
  ModifyFlags      Int      @default(0) @db.UnsignedInt
  MarketBid        Float    @default(0)
  MarketAsk        Float    @default(0)
  MarketLast       Float    @default(0)
  Volume           BigInt   @default(0) @db.UnsignedBigInt
  VolumeClosed     BigInt   @default(0) @db.UnsignedBigInt
  ApiData          String   @default("") @db.VarChar(4000)

  @@index([Timestamp], map: "IDX_mt5_deals_Timestamp")
}

