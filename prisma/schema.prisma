generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model accounts {
  id             Int                   @id @default(autoincrement())
  user_id        Int
  account_number BigInt                @unique(map: "account_number")
  account_type   accounts_account_type
  balance        Decimal?              @default(0.00) @db.Decimal(10, 2)
  status         accounts_status?      @default(active)
  created_at     DateTime              @default(now()) @db.Timestamp(0)
  updated_at     DateTime              @default(now()) @db.Timestamp(0)
  users          users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "accounts_ibfk_1")

  @@index([user_id], map: "user_id")
}

model brockrage_pk_mast {
  id         Int       @id @default(autoincrement())
  ib_id      Int
  pk_id      String    @db.Text
  pk_balance Float     @default(0) @db.Float
  currency   String    @db.Text
  ip         String?   @db.VarChar(25)
  created_at DateTime? @db.DateTime(0)
  updated_at DateTime? @db.DateTime(0)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model brockrage_pk_tran {
  id                 Int       @id @default(autoincrement())
  pk_id              String    @db.Text
  ref_id             String?   @db.Text
  ib_id              Int
  type               String    @db.VarChar(2)
  tran_from          String?   @db.VarChar(50)
  tran_to            String?   @db.VarChar(50)
  amount             Float?    @db.Float
  net_amount         Float     @db.Float
  balance            Float?    @db.Float
  our_transaction_id String?   @db.Text
  tran_type          String    @db.Text
  transaction_time   DateTime? @db.DateTime(0)
  comment            String?   @db.VarChar(150)
  ip                 String?   @db.VarChar(20)
  created_at         DateTime? @db.DateTime(0)
  updated_at         DateTime? @db.DateTime(0)
}

model brockrage_transaction_list {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email                    String?   @db.VarChar(255)
  job_id                   BigInt    @db.UnsignedBigInt
  ticket_no                BigInt    @db.UnsignedBigInt
  account_no_trader        BigInt    @db.UnsignedBigInt
  account_no_ib            BigInt    @db.UnsignedBigInt
  lot_size                 Decimal   @db.Decimal(10, 4)
  symbol                   String    @db.VarChar(50)
  total_usd_to_distribute  Decimal   @db.Decimal(10, 4)
  percentage_to_distribute Decimal   @db.Decimal(10, 2)
  amount                   Decimal   @db.Decimal(10, 4)
  trans_id                 BigInt?   @db.UnsignedBigInt
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)

  @@index([account_no_ib], map: "account_no_ib_index")
  @@index([account_no_trader], map: "account_no_trader_index")
  @@index([email], map: "email_index")
  @@index([job_id], map: "job_id_index")
  @@index([ticket_no], map: "ticket_no_index")
  @@index([trans_id], map: "trans_id_index")
}

model deposits {
  id                 Int                   @id @default(autoincrement())
  our_transaction_id String                @db.VarChar(255)
  user_id            Int
  amount             Decimal               @db.Decimal(10, 2)
  account_type       deposits_account_type
  account_number     String                @db.VarChar(255)
  status             deposits_status?      @default(pending)
  reason             String?               @db.VarChar(255)
  gateway            String                @db.VarChar(255)
  created_at         DateTime              @default(now()) @db.Timestamp(0)
  updated_at         DateTime              @default(now()) @db.Timestamp(0)
  users              users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "deposits_ibfk_1")

  @@index([user_id], map: "user_id")
}

model distribution {
  id           Int      @id @default(autoincrement())
  group        String?  @db.VarChar(255)
  col1         String?  @db.Text
  col2         String?  @db.Text
  col3         String?  @db.Text
  col4         String?  @db.Text
  col5         String?  @db.Text
  col6         String?  @db.Text
  col7         String?  @db.Text
  col8         String?  @db.Text
  col9         String?  @db.Text
  col10        String?  @db.Text
  col11        String?  @db.Text
  fx_majors    Float?
  fx_minors    Float?
  fx_yen       Float?
  spot_silver  Float?
  spot_gold    Float?
  spot_energy  Float?
  dow          Float?
  spot_indices Float?
  spxm         Float?
  crypto       Float?
  created_at   DateTime @db.DateTime(0)
  updated_at   DateTime @default(now()) @db.DateTime(0)
}

